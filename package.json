{
  "name": "zotero-paperflow",
  "version": "15.0.4",
  "description": "Manage manuscripts, submission rounds, and review responses. Part of Zotero Flow.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "build:bundle": "node scripts/build-source.mjs",
    "build:xpi": "python tools/build-xpi.py --update-feeds",
    "build": "npm run typecheck && npm run build:bundle && npm run build:xpi",
    "test:unit": "node --test tests/*.test.js",
    "test:package": "python scripts/test-release-package.py",
    "test:tags": "python scripts/release-tags.py --self-test",
    "test": "npm run typecheck && npm run build:bundle && npm run test:unit && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groele/Zotero-PaperFlow.git"
  },
  "author": "groele",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/groele/Zotero-PaperFlow/issues"
  },
  "homepage": "https://github.com/groele/Zotero-PaperFlow",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
